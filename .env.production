# Committed on purpose: this is a public API base URL, not a secret. Vite loads this file
# automatically during `vite build` (production mode), so hosted builds (Vercel, etc.) get
# VITE_API_BASE_URL baked in without needing it configured in the platform's dashboard.
VITE_API_BASE_URL=https://ictchamber-project-mgt-platform.onrender.com
